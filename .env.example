# Copie este arquivo para ".env" e preencha com os dados reais antes de rodar o projeto

SECRET_KEY=troque-por-uma-chave-secreta-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Mercado Pago ---
# Pegue em https://www.mercadopago.com.br/developers/panel
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxx
SITE_URL=http://127.0.0.1:8000

# --- Endereço da loja (ponto de partida para calcular a distância de entrega) ---
# Preencha com a latitude/longitude do endereço da loja.
# Dica: pesquise "meu CEP" no Google Maps, clique com o botão direito no
# pino do endereço da loja e copie as coordenadas que aparecem.
SHOP_LATITUDE=-23.550520
SHOP_LONGITUDE=-46.633308
DELIVERY_RADIUS_KM=3
